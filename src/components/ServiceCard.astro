---
import type { Service } from "../data/services";
import { localizePath, type Lang } from "../i18n/config";
import { useTranslations } from "../i18n/ui";

interface Props {
  service: Service;
  lang: Lang;
  email: string;
  /** Home-page variant: no bullet list, links through to /services instead. */
  compact?: boolean;
}
const { service, lang, email, compact = false } = Astro.props;
const t = useTranslations(lang);

// Pre-filled subject so an enquiry arrives already labelled by service.
const mailto = `mailto:${email}?subject=${encodeURIComponent(service.emailSubject)}`;
---

<article
  id={compact ? undefined : service.id}
  class:list={[
    "flex flex-col rounded-lg border border-line bg-ink-850 p-6",
    compact ? "card-hover" : "scroll-mt-24 sm:p-8",
  ]}
>
  <span
    class="mb-5 grid h-10 w-10 place-items-center rounded-md border border-line bg-ink-900 text-beacon"
    aria-hidden="true"
  >
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d={service.icon} />
    </svg>
  </span>

  <h3 class:list={["text-fog-100", compact ? "text-xl" : "text-2xl"]}>
    {service.title}
  </h3>
  <p class="eyebrow mt-2">{service.tagline}</p>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-fog-300">{service.description}</p>

  {
    !compact && (
      <ul class="mt-5 space-y-2.5">
        {service.bullets.map((b) => (
          <li class="flex gap-3 text-sm leading-relaxed text-fog-300">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-beacon" aria-hidden="true" />
            <span>{b}</span>
          </li>
        ))}
      </ul>
    )
  }

  {
    !compact && (
      <dl class="mt-6 space-y-1.5 border-t border-line/60 pt-5 text-sm">
        <div class="flex flex-wrap gap-x-2">
          <dt class="text-fog-400">{t("services.formatLabel")}</dt>
          <dd class="text-fog-200">{service.format}</dd>
        </div>
        <div class="flex flex-wrap gap-x-2">
          <dt class="text-fog-400">{t("services.rateLabel")}</dt>
          <dd class="text-fog-200">{t("services.rateOnRequest")}</dd>
        </div>
      </dl>
    )
  }

  {
    compact ? (
      <a
        href={`${localizePath("/services", lang)}#${service.id}`}
        class="mt-5 inline-flex items-center gap-1.5 text-sm text-beacon hover:text-beacon-600"
      >
        {t("services.cta")}
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    ) : (
      <a
        href={mailto}
        class="mt-6 self-start rounded-md bg-beacon px-5 py-2.5 text-sm font-semibold text-on-beacon transition-colors hover:bg-beacon-600"
      >
        {t("services.cta")}
      </a>
    )
  }
</article>
