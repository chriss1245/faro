---
import { getSite } from "../data/site";
import { localizePath, type Lang } from "../i18n/config";
import { useTranslations } from "../i18n/ui";
import ThemeToggle from "./ThemeToggle.astro";
import LangSwitcher from "./LangSwitcher.astro";
import Logo from "./Logo.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const site = getSite(lang);

// Ordered the way the home page now reads: what I offer, then the credential
// behind it, then the work, then the writing and the CV.
const links = [
  { route: "/services", label: t("nav.services") },
  { route: "/academia", label: t("nav.academia") },
  { route: "/#work", label: t("nav.work") },
  { route: "/writing", label: t("nav.writing") },
  { route: "/cv", label: t("nav.cv") },
];
---

<header class="sticky top-3 z-50 px-3 sm:top-4 sm:px-4">
  <nav
    class="glass-panel mx-auto flex max-w-4xl items-center justify-between gap-3 rounded-full px-3 py-2 shadow-[0_20px_50px_-28px_rgba(0,0,0,.55)] sm:gap-4 sm:px-4"
  >
    <a
      href={localizePath("/", lang)}
      class="group flex shrink-0 items-center pl-1"
      aria-label={`${site.name} — ${t("nav.home")}`}
    >
      <!-- The full wordmark eats the whole bar on a phone and pushes the
           language and theme controls off-screen, so narrow viewports get the
           symbol instead. -->
      <Logo variant="symbol" class="inline-flex h-9 sm:hidden" />
      <Logo variant="wordmark" class="hidden h-9 sm:inline-flex" />
    </a>

    <div class="flex min-w-0 items-center gap-3 text-sm text-fog-300 sm:gap-4">
      <!-- Inline links only where they fit; phones get the menu button below. -->
      <div class="hidden items-center gap-4 md:flex">
        {
          links.map((l) => (
            <a
              href={localizePath(l.route, lang)}
              class="link-underline shrink-0 whitespace-nowrap hover:text-fog-100"
            >
              {l.label}
            </a>
          ))
        }
      </div>
      <div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
        <LangSwitcher lang={lang} />
        <ThemeToggle />
        <button
          type="button"
          popovertarget="mobile-nav"
          class="grid h-10 w-10 place-items-center rounded-full text-fog-100 transition-colors hover:text-beacon md:hidden"
          aria-label={t("nav.menu")}
          title={t("nav.menu")}
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </div>
      {
        site.email && (
          <a
            href={`mailto:${site.email}`}
            class="btn-gradient hidden shrink-0 rounded-full px-4 py-1.5 text-sm font-semibold xl:inline-block"
          >
            {t("nav.contact")}
          </a>
        )
      }
    </div>
  </nav>

  <!-- Phone menu. The Popover API gives light-dismiss, Esc and the top layer
       for free, so this needs no JavaScript beyond closing it on in-page
       anchors (e.g. /#work), where no navigation happens. -->
  <div id="mobile-nav" popover class="mobile-nav glass-panel md:hidden">
    <nav aria-label={t("nav.menu")} class="flex flex-col">
      {
        links.map((l) => (
          <a
            href={localizePath(l.route, lang)}
            class="rounded-2xl px-4 py-3.5 text-base font-medium text-fog-100 transition-colors hover:bg-ink-800"
          >
            {l.label}
          </a>
        ))
      }
    </nav>
    {
      site.email && (
        <a
          href={`mailto:${site.email}`}
          class="btn-gradient mt-2 block rounded-full px-4 py-3 text-center text-base font-semibold"
        >
          {t("nav.contact")}
        </a>
      )
    }
  </div>
</header>

<script>
  const menu = document.getElementById("mobile-nav");
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => menu.hidePopover()),
  );
</script>
