---
import type { Project, ProjectStatus } from "../data/projects";
import { localizePath, type Lang } from "../i18n/config";
import { useTranslations } from "../i18n/ui";

interface Props {
  project: Project;
  lang: Lang;
}
const { project, lang } = Astro.props;
const t = useTranslations(lang);

const statusStyles: Record<ProjectStatus, string> = {
  live: "border-aqua/40 text-aqua",
  building: "border-beacon/40 text-beacon",
  soon: "border-line text-fog-400",
};
const statusLabel: Record<ProjectStatus, string> = {
  live: t("project.status.live"),
  building: t("project.status.building"),
  soon: t("project.status.soon"),
};
---

<a
  href={localizePath(`/${project.slug}`, lang)}
  class="card-hover group relative flex flex-col rounded-lg border border-line bg-ink-850 p-6"
>
  <div class="mb-3 flex items-center justify-between gap-3">
    <h3 class="font-serif text-xl text-fog-100">{project.name}</h3>
    <span
      class={`rounded-sm border px-2 py-0.5 text-[0.7rem] font-semibold uppercase tracking-wider ${statusStyles[project.status]}`}
    >
      {statusLabel[project.status]}
    </span>
  </div>

  <p class="text-sm font-medium text-fog-200">{project.tagline}</p>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-fog-400">{project.description}</p>

  <!-- A quiet middot-separated line rather than a row of chips: fewer boxes,
       and the stack reads as a caption instead of as UI. -->
  <p class="mt-4 text-[0.72rem] leading-relaxed text-fog-400">{project.tags.join(" · ")}</p>

  <span class="mt-5 inline-flex items-center gap-1.5 text-sm text-beacon">
    {t("project.view")}
    <svg
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      class="transition-transform group-hover:translate-x-0.5"
      aria-hidden="true"
    >
      <path d="M5 12h14M13 6l6 6-6 6" />
    </svg>
  </span>
</a>
