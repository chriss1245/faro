---
import Layout from "../../layouts/Layout.astro";
import ServiceCard from "../ServiceCard.astro";
import { getSite } from "../../data/site";
import { getServices, servicesIntro, faq } from "../../data/services";
import type { Lang } from "../../i18n/config";
import { useTranslations } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const site = getSite(lang);
const services = getServices(lang);
const intro = servicesIntro[lang];
const questions = faq[lang];

// One Service entity per offering, so search engines can surface them as
// distinct services rather than as one page about "consulting".
const servicesLd = {
  "@context": "https://schema.org",
  "@graph": services.map((s) => ({
    "@type": "Service",
    name: s.title,
    description: s.description,
    serviceType: s.tagline,
    areaServed: [{ "@type": "Country", name: "Spain" }, { "@type": "Place", name: "Remote" }],
    availableLanguage: ["es", "en"],
    provider: {
      "@type": "Person",
      name: site.name,
      jobTitle: site.role,
      url: `https://${site.domain}`,
      email: `mailto:${site.email}`,
    },
  })),
};

// FAQPage — a direct question followed by a direct answer is the format answer
// engines extract most reliably, and it doubles as pre-sales friction removal.
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: questions.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<Layout
  lang={lang}
  title={t("services.navTitle")}
  description={intro.seoDescription}
  image="/og/services.png"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(servicesLd)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqLd)} />

  <div class="mx-auto max-w-5xl px-6 pt-20 pb-20">
    <header class="max-w-2xl">
      <p class="eyebrow eyebrow-rule mb-4">{t("services.eyebrow")}</p>
      <h1 class="text-4xl leading-tight text-fog-100 sm:text-5xl">
        {t("services.title")}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-fog-300">{intro.lead}</p>
    </header>

    <div class="mt-14 space-y-6">
      {services.map((service) => <ServiceCard service={service} lang={lang} email={site.email} />)}
    </div>

    <!-- Answers rendered as plain visible prose, not collapsed into <details>:
         the text is the point, for readers and for extraction alike. -->
    <section class="mt-20">
      <h2 class="text-2xl text-fog-100 sm:text-3xl">{t("services.faqTitle")}</h2>
      <dl class="mt-8 space-y-8">
        {
          questions.map((item) => (
            <div class="border-t border-line pt-6">
              <dt class="text-base font-semibold text-fog-100">{item.q}</dt>
              <dd class="mt-2.5 max-w-2xl text-sm leading-relaxed text-fog-400">{item.a}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- Catch-all for enquiries that fit none of the three -->
    <div
      class="mt-12 flex flex-col items-start justify-between gap-6 rounded-lg border border-line bg-ink-900 p-8 sm:flex-row sm:items-center"
    >
      <div class="max-w-xl">
        <h2 class="text-xl font-semibold text-fog-100">{t("services.contactTitle")}</h2>
        <p class="mt-2 text-sm leading-relaxed text-fog-400">{t("services.contactBody")}</p>
      </div>
      <a
        href={`mailto:${site.email}`}
        class="shrink-0 rounded-md bg-beacon px-5 py-2.5 text-sm font-semibold text-on-beacon transition-colors hover:bg-beacon-600"
      >
        {t("services.contactCta")}
      </a>
    </div>
  </div>
</Layout>
