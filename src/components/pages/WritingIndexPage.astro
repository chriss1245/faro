---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { defaultLang, localeTags, type Lang } from "../../i18n/config";
import { useTranslations } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = (await getCollection("writing", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = (d: Date) =>
  d.toLocaleDateString(localeTags[lang], { year: "numeric", month: "short", day: "numeric" });

// Posts themselves are English-only, so the Spanish index links out to the
// English article and says so up front rather than leading readers into a
// language switch they did not ask for.
const postsAreForeign = lang !== defaultLang;
---

<Layout lang={lang} title={t("writing.title")} description={t("writing.seoDescription")}>
  <section class="mx-auto max-w-3xl px-6 pt-20 pb-16">
    <p class="eyebrow eyebrow-rule mb-2">{t("writing.eyebrow")}</p>
    <h1 class="text-4xl text-fog-100 sm:text-5xl">{t("writing.heading")}</h1>
    <p class="mt-3 max-w-xl text-fog-300">{t("writing.lead")}</p>

    {
      postsAreForeign && (
        <p
          class="mt-6 rounded-lg border border-line bg-ink-850 px-4 py-3 text-sm leading-relaxed text-fog-400"
          role="note"
        >
          {t("writing.englishOnlyNotice")}
        </p>
      )
    }

    <div class="mt-12 divide-y divide-line/70">
      {posts.length === 0 && <p class="text-fog-400">{t("writing.empty")}</p>}
      {
        posts.map((post) => (
          <a href={`/writing/${post.id}`} class="group flex flex-col gap-1 py-6" hreflang="en">
            <span class="numeric text-xs text-fog-400">{fmt(post.data.date)}</span>
            <h2
              lang="en"
              class="text-xl font-medium text-fog-100 transition-colors group-hover:text-beacon"
            >
              {post.data.title}
            </h2>
            <p lang="en" class="text-sm text-fog-400">
              {post.data.description}
            </p>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
