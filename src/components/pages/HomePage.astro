---
import Layout from "../../layouts/Layout.astro";
import Socials from "../Socials.astro";
import ProjectCard from "../ProjectCard.astro";
import ServiceCard from "../ServiceCard.astro";
import { getSite } from "../../data/site";
import { getProjects } from "../../data/projects";
import { getThesis } from "../../data/academia";
import { getServices, servicesIntro } from "../../data/services";
import { localizePath, type Lang } from "../../i18n/config";
import { useTranslations } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const site = getSite(lang);
const projects = getProjects(lang);
const thesis = getThesis(lang);
const services = getServices(lang);

const focus = [t("focus.llm"), t("focus.quant"), t("focus.infra"), t("focus.public")];

// Real tech, pulled from each project's own stack groups (src/data/projects.ts)
// rather than hardcoded, so the strip can't drift out of sync with them.
const stackItems = Array.from(new Set(projects.flatMap((p) => p.stack.flatMap((g) => g.items))));

const liveCount = projects.filter((p) => p.status === "live").length;
const accents = ["beacon", "flare", "aqua"] as const;

// JSON-LD Person — helps Google associate this site with me and disambiguate
// homonyms. `makesOffer` surfaces the freelance services as structured data.
const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  jobTitle: site.role,
  description: site.tagline,
  url: `https://${site.domain}`,
  email: `mailto:${site.email}`,
  address: { "@type": "PostalAddress", addressLocality: site.location },
  sameAs: [
    `https://github.com/${site.socials.github}`,
    `https://www.linkedin.com/in/${site.socials.linkedin}`,
    `https://orcid.org/${site.orcid}`,
    `https://www.kaggle.com/${site.socials.kaggle}`,
  ],
  identifier: {
    "@type": "PropertyValue",
    propertyID: "ORCID",
    value: `https://orcid.org/${site.orcid}`,
  },
  alumniOf: { "@type": "CollegeOrUniversity", name: thesis.institution },
  // Mirrors the employment entry on the ORCID record — same person, same
  // employer, asserted in both places.
  worksFor: { "@type": "Organization", name: "WhiteBoxML" },
  knowsLanguage: ["es", "en"],
  knowsAbout: [
    "Machine Learning",
    "Multi-agent systems",
    "LangGraph",
    "Large Language Models",
    "Data Science",
    "MLOps",
    "Reinforcement Learning",
  ],
  // How to actually engage. `makesOffer` says what is on offer; this says
  // through which door, in which languages — an explicit fact for an answer
  // engine to extract rather than one inferred from a mailto link in the markup.
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "Business enquiries",
    email: site.email,
    url: new URL(localizePath("/services", lang), Astro.site).href,
    availableLanguage: ["es", "en"],
    areaServed: [
      { "@type": "Country", name: "Spain" },
      { "@type": "Place", name: "Remote worldwide" },
    ],
  },
  makesOffer: services.map((s) => ({
    "@type": "Offer",
    itemOffered: { "@type": "Service", name: s.title, description: s.tagline },
  })),
};
---

<Layout lang={lang}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(personLd)} />

  <!-- Hero. Name first, claim second: a consultant introduces themselves
       before they pitch. -->
  <section class="mx-auto max-w-5xl px-6 pt-16 pb-6 text-center sm:pt-24">
    <span
      class="glass-panel mx-auto mb-7 inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-xs text-fog-300"
    >
      <span class="h-2 w-2 shrink-0 rounded-full bg-beacon" aria-hidden="true"></span>
      {t("home.eyebrow")}
    </span>
    <h1 class="mx-auto max-w-3xl text-[2.1rem] leading-[1.12] text-fog-100 sm:text-[3.4rem] sm:leading-[1.08]">
      {site.heroLead}
      <span class="text-gradient">{site.heroAccent}</span>.
    </h1>
    <p class="mx-auto mt-7 max-w-2xl text-lg leading-relaxed text-fog-300">
      {t("home.intro")} <span class="font-medium text-fog-100">{site.name}</span>. {site.heroBody}
    </p>

    <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
      <a href={localizePath("/services", lang)} class="btn-gradient rounded-full px-6 py-3 text-sm font-semibold">
        {t("services.title")}
      </a>
      <a
        href={localizePath("/cv", lang)}
        class="glass-panel rounded-full px-6 py-3 text-sm font-medium text-fog-100 transition-colors hover:text-beacon"
      >
        {t("home.ctaCv")}
      </a>
    </div>
    <p class="mt-4 text-xs text-fog-400">{t("home.trust")}</p>
    <div class="mt-4 flex justify-center"><Socials /></div>
  </section>

  <!-- Hero visual: the two live systems, the research credential and the
       working basics, in one glass panel — built entirely from real data
       (getProjects / getThesis / getSite), not placeholder copy. -->
  <section class="relative mx-auto max-w-4xl px-6 pb-16">
    <div class="glass-panel overflow-hidden rounded-2xl shadow-[0_60px_100px_-50px_rgba(0,0,0,.5)]">
      <div class="flex items-center gap-2 border-b border-line px-5 py-3">
        <span class="h-2.5 w-2.5 rounded-full bg-ink-700" aria-hidden="true"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-ink-700" aria-hidden="true"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-ink-700" aria-hidden="true"></span>
        <span class="numeric ml-auto text-xs text-fog-400">{t("home.work.eyebrow")}</span>
      </div>
      <div class="grid gap-4 p-5 sm:grid-cols-2">
        {
          projects.map((project) => (
            <a
              href={localizePath(`/${project.slug}`, lang)}
              class="rounded-xl border border-line p-4 transition-colors hover:border-beacon/40"
            >
              <p class="flex items-center gap-2 text-sm font-semibold text-fog-100">
                <span class="h-1.5 w-1.5 rounded-full bg-aqua" style="box-shadow:0 0 8px var(--color-aqua)" aria-hidden="true" />
                {project.name}
              </p>
              <p class="mt-1.5 text-xs leading-relaxed text-fog-400">{project.tagline}</p>
            </a>
          ))
        }
        <a
          href={localizePath("/academia", lang)}
          class="rounded-xl border border-line p-4 transition-colors hover:border-beacon/40"
        >
          <p class="flex items-center gap-2 text-sm font-semibold text-fog-100">
            <span class="h-1.5 w-1.5 rounded-full bg-flare" style="box-shadow:0 0 8px var(--color-flare)" aria-hidden="true" />
            {t("home.academia.title")}
          </p>
          <p class="mt-1.5 text-xs leading-relaxed text-fog-400">{thesis.title}</p>
        </a>
        <div class="rounded-xl border border-line p-4">
          <p class="flex items-center gap-2 text-sm font-semibold text-fog-100">
            <span class="h-1.5 w-1.5 rounded-full bg-beacon" style="box-shadow:0 0 8px var(--color-beacon)" aria-hidden="true" />
            {site.role}
          </p>
          <p class="mt-1.5 text-xs leading-relaxed text-fog-400">{site.location}</p>
        </div>
      </div>
    </div>

    <!-- Real stack, pulled from the two live systems' own data — see
         stackItems above. -->
    <div class="mt-6 flex flex-wrap justify-center gap-2">
      {
        stackItems.map((item) => (
          <span class="rounded-full border border-line bg-ink-850/60 px-3.5 py-1.5 text-xs font-medium text-fog-300">
            {item}
          </span>
        ))
      }
    </div>

    <!-- Focus areas as a caption line. -->
    <p class="mt-8 text-center text-sm text-fog-400">{focus.join("  ·  ")}</p>
  </section>

  <!-- Stats — every figure here is real: derived from cv.ts ("nearly four
       years" of client delivery), the project data (live, self-hosted
       systems) and the academia data (the one published thesis). -->
  <section class="mx-auto max-w-5xl px-6 pb-4">
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="card rounded-xl px-4 py-5 text-center">
        <p class="numeric text-2xl font-semibold text-fog-100">~4</p>
        <p class="mt-1 text-xs text-fog-400">{t("home.stats.experience")}</p>
      </div>
      <div class="card rounded-xl px-4 py-5 text-center">
        <p class="numeric text-2xl font-semibold text-fog-100">{liveCount}</p>
        <p class="mt-1 text-xs text-fog-400">{t("home.stats.systems")}</p>
      </div>
      <div class="card rounded-xl px-4 py-5 text-center">
        <p class="numeric text-2xl font-semibold text-fog-100">1</p>
        <p class="mt-1 text-xs text-fog-400">{t("home.stats.thesis")}</p>
      </div>
      <div class="card rounded-xl px-4 py-5 text-center">
        <p class="numeric text-2xl font-semibold text-fog-100">ES / EN</p>
        <p class="mt-1 text-xs text-fog-400">{t("home.stats.languages")}</p>
      </div>
    </div>
  </section>

  <!-- Services. Moved above the project grid: the offering is what a visitor
       who can hire me needs to see first. -->
  <section id="services" class="mx-auto max-w-5xl scroll-mt-24 px-6 py-16">
    <div class="mb-8">
      <p class="eyebrow eyebrow-rule mb-3">{t("services.eyebrow")}</p>
      <h2 class="text-3xl text-fog-100 sm:text-4xl">{t("services.title")}</h2>
      <p class="mt-4 max-w-2xl leading-relaxed text-fog-300">{servicesIntro[lang].lead}</p>
    </div>

    <div class="bento">
      {
        services.map((service, i) => (
          <ServiceCard
            service={service}
            lang={lang}
            email={site.email}
            compact
            size={i === 0 ? "lg" : "md"}
            accent={accents[i % accents.length]}
          />
        ))
      }
    </div>
  </section>

  <!-- Academia teaser — the credential behind the offering, so it follows it. -->
  <section class="mx-auto max-w-5xl px-6 py-16">
    <div class="mb-8">
      <p class="eyebrow eyebrow-rule mb-3">{t("home.academia.eyebrow")}</p>
      <h2 class="text-3xl text-fog-100 sm:text-4xl">{t("home.academia.title")}</h2>
    </div>

    <a
      href={localizePath("/academia", lang)}
      class="card-hover group block rounded-lg border border-line bg-ink-850 p-6 sm:p-8"
    >
      <div class="flex flex-wrap items-center gap-2.5">
        <span class="rounded-sm border border-aqua/45 px-2 py-0.5 text-[0.7rem] font-semibold uppercase tracking-wider text-aqua">
          {thesis.kind}
        </span>
        <span class="numeric text-xs text-fog-400">{thesis.institution} · {thesis.defended}</span>
      </div>

      <h3 class="mt-4 max-w-3xl text-xl leading-snug text-fog-100 sm:text-2xl">
        {thesis.title}
      </h3>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-fog-300">{thesis.summary}</p>

      <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2">
        <span class="numeric text-xs text-fog-400">DOI {thesis.doi}</span>
        <span class="inline-flex items-center gap-1.5 text-sm text-beacon">
          {t("home.academia.cta")}
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="transition-transform group-hover:translate-x-0.5"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </span>
      </div>
    </a>
  </section>

  <!-- Work -->
  <section id="work" class="mx-auto max-w-5xl scroll-mt-24 px-6 py-16">
    <div class="mb-8 flex items-end justify-between gap-4">
      <div>
        <p class="eyebrow eyebrow-rule mb-3">{t("home.work.eyebrow")}</p>
        <h2 class="text-3xl text-fog-100 sm:text-4xl">{t("home.work.title")}</h2>
      </div>
      <p class="hidden max-w-xs text-right text-sm text-fog-400 sm:block">
        {t("home.work.note")}
      </p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      {projects.map((project) => <ProjectCard project={project} lang={lang} />)}
    </div>
  </section>

  <!-- Contact. The offering lives above; this closes the page with the ask. -->
  <section id="contact" class="mx-auto max-w-5xl scroll-mt-24 px-6 pt-4 pb-24">
    <div
      class="relative flex flex-col items-start justify-between gap-6 overflow-hidden rounded-2xl border border-line bg-ink-900 p-8 sm:flex-row sm:items-center sm:p-10"
    >
      <div
        class="pointer-events-none absolute -top-32 left-1/2 h-72 w-72 -translate-x-1/2 rounded-full bg-beacon opacity-20 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div class="relative">
        <h3 class="text-2xl text-fog-100 sm:text-3xl">{t("contact.title")}</h3>
        <p class="mt-2 text-fog-300">{t("contact.body")}</p>
      </div>
      {
        site.email && (
          <a href={`mailto:${site.email}`} class="btn-gradient relative shrink-0 rounded-full px-6 py-3 text-sm font-semibold">
            {t("contact.cta")}
          </a>
        )
      }
    </div>
  </section>
</Layout>
