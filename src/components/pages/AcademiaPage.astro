---
import Layout from "../../layouts/Layout.astro";
import { getSite } from "../../data/site";
import { getThesis, getPublications, getAcademicProjects } from "../../data/academia";
import { localizePath, type Lang } from "../../i18n/config";
import { useTranslations } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const site = getSite(lang);
const thesis = getThesis(lang);
const publications = getPublications(lang);
const academicProjects = getAcademicProjects(lang);

const doiUrl = `https://doi.org/${thesis.doi}`;

// Author block, shared by every JSON-LD node on the page.
const personLd = {
  "@type": "Person",
  name: site.name,
  url: `https://${site.domain}`,
  sameAs: `https://orcid.org/${site.orcid}`,
  identifier: {
    "@type": "PropertyValue",
    propertyID: "ORCID",
    value: `https://orcid.org/${site.orcid}`,
  },
};

const pageUrl = new URL(localizePath("/academia", lang), Astro.site).href;

// JSON-LD for the DOI-archived research — same idea as the thesis node: give
// Google and Scholar the DOI, author and repo so this page and the Zenodo
// record resolve to one work. The works themselves are in English.
const publicationsLd = publications.map((pub) => ({
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: pub.title,
  abstract: pub.abstract.join(" "),
  datePublished: pub.datePublished,
  inLanguage: "en",
  codeRepository: pub.codeUrl,
  identifier: { "@type": "PropertyValue", propertyID: "DOI", value: pub.doi },
  sameAs: [`https://doi.org/${pub.doi}`, pub.recordUrl],
  url: pageUrl,
  keywords: pub.keywords.join(", "),
  license: pub.licenseUrl,
  author: personLd,
  publisher: { "@type": "Organization", name: "Zenodo" },
}));

// JSON-LD Thesis — gives Google (and Scholar) the DOI, author and institution
// so the record on Zenodo and this page resolve to the same piece of work.
// The thesis itself is in English regardless of the page locale.
const thesisLd = {
  "@context": "https://schema.org",
  "@type": "Thesis",
  inSupportOf: thesis.degree,
  name: thesis.title,
  headline: thesis.title,
  abstract: thesis.abstract.join(" "),
  datePublished: thesis.datePublished,
  inLanguage: "en",
  identifier: { "@type": "PropertyValue", propertyID: "DOI", value: thesis.doi },
  sameAs: [doiUrl, thesis.recordUrl],
  url: pageUrl,
  keywords: thesis.keywords.join(", "),
  license: thesis.licenseUrl,
  author: personLd,
  publisher: { "@type": "Organization", name: "Zenodo" },
  sourceOrganization: { "@type": "CollegeOrUniversity", name: thesis.institution },
  contributor: { "@type": "Person", name: thesis.supervisor },
};

const description = `${thesis.title} — ${thesis.kind}, ${thesis.institution} (${thesis.defended}), DOI ${thesis.doi}.`;
const citationYear = new Date(thesis.datePublished).getFullYear();
---

<Layout
  lang={lang}
  title={t("nav.academia")}
  description={description}
  image="/og/academia.png"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(thesisLd)} />
  {
    publicationsLd.map((ld) => (
      <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />
    ))
  }

  <div class="mx-auto max-w-3xl px-6 pt-20 pb-20">
    <!-- Intro -->
    <header>
      <p class="eyebrow eyebrow-rule mb-4">{t("academia.eyebrow")}</p>
      <h1 class="text-4xl leading-tight text-fog-100 sm:text-5xl">
        {t("academia.title")}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-fog-300">{thesis.summary}</p>
    </header>

    <!-- Featured: the thesis -->
    <section class="mt-14" aria-labelledby="thesis-title">
      <h2 class="eyebrow eyebrow-rule mb-4">{t("academia.thesisEyebrow")}</h2>

      <article class="rounded-lg border border-line bg-ink-850 p-6 sm:p-8">
        <div class="flex flex-wrap items-center gap-2.5">
          <span
            class="rounded-sm border border-aqua/45 px-2 py-0.5 text-[0.7rem] font-semibold uppercase tracking-wider text-aqua"
          >
            {thesis.kind}
          </span>
          <span class="numeric text-xs text-fog-400">
            <time datetime={thesis.datePublished}>{thesis.defended}</time>
          </span>
        </div>

        <!-- The title stays in its original language; lang= tells screen
             readers and translators not to read it as Spanish. -->
        <h3
          id="thesis-title"
          lang="en"
          class="mt-4 text-2xl font-semibold leading-snug text-fog-100 sm:text-3xl"
        >
          {thesis.title}
        </h3>

        <dl class="mt-5 space-y-1.5 text-sm">
          <div class="flex flex-wrap gap-x-2">
            <dt class="text-fog-400">{t("academia.degree")}</dt>
            <dd class="text-fog-200">{thesis.degree}</dd>
          </div>
          <div class="flex flex-wrap gap-x-2">
            <dt class="text-fog-400">{t("academia.institution")}</dt>
            <dd class="text-fog-200">{thesis.institution}</dd>
          </div>
          <div class="flex flex-wrap gap-x-2">
            <dt class="text-fog-400">{t("academia.supervisor")}</dt>
            <dd class="text-fog-200">{thesis.supervisor}</dd>
          </div>
          <div class="flex flex-wrap gap-x-2">
            <dt class="text-fog-400">{t("academia.doi")}</dt>
            <dd>
              <a
                href={doiUrl}
                class="link-underline numeric text-beacon"
                target="_blank"
                rel="noopener"
              >
                {thesis.doi}
              </a>
            </dd>
          </div>
        </dl>

        <!-- Actions -->
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a
            href={thesis.pdfUrl}
            target="_blank"
            rel="noopener"
            class="rounded-md bg-beacon px-5 py-2.5 text-sm font-semibold text-on-beacon transition-colors hover:bg-beacon-600"
          >
            {t("academia.readPdf")}
          </a>
          <a
            href={thesis.recordUrl}
            target="_blank"
            rel="noopener"
            class="rounded-md border border-line bg-ink-800 px-5 py-2.5 text-sm font-medium text-fog-100 transition-colors hover:border-beacon/50 hover:text-beacon"
          >
            {t("academia.record")}
          </a>
          {
            thesis.codeUrl && (
              <a
                href={thesis.codeUrl}
                target="_blank"
                rel="noopener"
                class="rounded-md border border-line bg-ink-800 px-5 py-2.5 text-sm font-medium text-fog-100 transition-colors hover:border-beacon/50 hover:text-beacon"
              >
                {t("academia.code")}
              </a>
            )
          }
        </div>

        <!-- Abstract -->
        <div class="mt-8 space-y-4 leading-relaxed text-fog-300">
          {thesis.abstract.map((p) => <p>{p}</p>)}
        </div>

        <!-- Contributions -->
        <h4 class="eyebrow eyebrow-rule mt-9 mb-4">{t("academia.contributions")}</h4>
        <ul class="space-y-3">
          {
            thesis.contributions.map((c) => (
              <li class="flex gap-3 text-sm leading-relaxed text-fog-300">
                <span
                  class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-beacon"
                  aria-hidden="true"
                />
                <span>{c}</span>
              </li>
            ))
          }
        </ul>

        <!-- Evaluation setup -->
        <h4 class="eyebrow eyebrow-rule mt-9 mb-4">{t("academia.evaluation")}</h4>
        <dl class="divide-y divide-line/70 overflow-hidden rounded-lg border border-line">
          {
            thesis.evaluation.map((row) => (
              <div class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:gap-4">
                <dt class="numeric text-xs uppercase tracking-wide text-fog-400 sm:w-48 sm:shrink-0 sm:pt-0.5">
                  {row.label}
                </dt>
                <dd class="text-sm text-fog-200">{row.value}</dd>
              </div>
            ))
          }
        </dl>

        <!-- Keywords + license -->
        <div class="mt-8 flex flex-wrap gap-1.5">
          {
            thesis.keywords.map((k) => (
              <span class="rounded-md bg-ink-800 px-2 py-0.5 text-[0.7rem] text-fog-300">
                {k}
              </span>
            ))
          }
        </div>
        <p class="mt-5 border-t border-line/60 pt-5 text-xs text-fog-400">
          {t("academia.licensedUnder")}
          <a
            href={thesis.licenseUrl}
            target="_blank"
            rel="noopener license"
            class="link-underline text-fog-300">{thesis.licenseLabel}</a
          >. {t("academia.citeAs")}: {site.name}. ({citationYear}).
          <em lang="en">{thesis.title}</em> [{thesis.kind}]. {thesis.institution}. Zenodo.
          <a href={doiUrl} target="_blank" rel="noopener" class="link-underline text-fog-300"
            >{doiUrl}</a
          >
        </p>
      </article>
    </section>

    <!-- Independent research -->
    <section class="mt-16" aria-labelledby="research-title">
      <h2 id="research-title" class="eyebrow eyebrow-rule mb-6">
        {t("academia.researchEyebrow")}
      </h2>

      <div class="space-y-4">
        {
          publications.map((pub) => {
            const pubDoiUrl = `https://doi.org/${pub.doi}`;
            const pubYear = new Date(pub.datePublished).getFullYear();
            return (
              <article class="rounded-lg border border-line bg-ink-850 p-6 sm:p-8">
                <div class="flex flex-wrap items-center gap-2.5">
                  <span class="rounded-sm border border-aqua/45 px-2 py-0.5 text-[0.7rem] font-semibold uppercase tracking-wider text-aqua">
                    {pub.kind}
                  </span>
                  <span class="numeric text-xs text-fog-400">
                    <time datetime={pub.datePublished}>{pub.published}</time>
                  </span>
                </div>

                {/* Title stays in its original language. */}
                <h3
                  lang="en"
                  class="mt-4 text-xl font-semibold leading-snug text-fog-100 sm:text-2xl"
                >
                  {pub.title}
                </h3>

                <dl class="mt-5 space-y-1.5 text-sm">
                  <div class="flex flex-wrap gap-x-2">
                    <dt class="text-fog-400">{t("academia.affiliation")}</dt>
                    <dd class="text-fog-200">{pub.affiliation}</dd>
                  </div>
                  <div class="flex flex-wrap gap-x-2">
                    <dt class="text-fog-400">{t("academia.doi")}</dt>
                    <dd>
                      <a
                        href={pubDoiUrl}
                        class="link-underline numeric text-beacon"
                        target="_blank"
                        rel="noopener"
                      >
                        {pub.doi}
                      </a>
                    </dd>
                  </div>
                </dl>

                <div class="mt-7 flex flex-wrap items-center gap-3">
                  <a
                    href={pub.recordUrl}
                    target="_blank"
                    rel="noopener"
                    class="rounded-md bg-beacon px-5 py-2.5 text-sm font-semibold text-on-beacon transition-colors hover:bg-beacon-600"
                  >
                    {t("academia.record")}
                  </a>
                  <a
                    href={pub.codeUrl}
                    target="_blank"
                    rel="noopener"
                    class="rounded-md border border-line bg-ink-800 px-5 py-2.5 text-sm font-medium text-fog-100 transition-colors hover:border-beacon/50 hover:text-beacon"
                  >
                    {t("academia.code")}
                  </a>
                </div>

                <div class="mt-8 space-y-4 leading-relaxed text-fog-300">
                  {pub.abstract.map((p) => (
                    <p>{p}</p>
                  ))}
                </div>

                <h4 class="eyebrow eyebrow-rule mt-9 mb-4">{t("academia.keyResults")}</h4>
                <ul class="space-y-3">
                  {pub.findings.map((f) => (
                    <li class="flex gap-3 text-sm leading-relaxed text-fog-300">
                      <span
                        class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-beacon"
                        aria-hidden="true"
                      />
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>

                <div class="mt-8 flex flex-wrap gap-1.5">
                  {pub.keywords.map((k) => (
                    <span class="rounded-md bg-ink-800 px-2 py-0.5 text-[0.7rem] text-fog-300">
                      {k}
                    </span>
                  ))}
                </div>
                <p class="mt-5 border-t border-line/60 pt-5 text-xs text-fog-400">
                  {t("academia.licensedUnder")}
                  <a
                    href={pub.licenseUrl}
                    target="_blank"
                    rel="noopener license"
                    class="link-underline text-fog-300">{pub.licenseLabel}</a
                  >. {t("academia.citeAs")}: {site.name}. ({pubYear}).
                  <em lang="en">{pub.title}</em>. Zenodo.
                  <a href={pubDoiUrl} target="_blank" rel="noopener" class="link-underline text-fog-300"
                    >{pubDoiUrl}</a
                  >
                </p>
              </article>
            );
          })
        }
      </div>
    </section>

    <!-- Case studies -->
    <section class="mt-16">
      <h2 class="eyebrow eyebrow-rule mb-6">{t("academia.caseStudies")}</h2>

      <div class="space-y-4">
        {
          academicProjects.map((p) => (
            <article class="card-hover rounded-lg border border-line bg-ink-850 p-6">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="text-lg font-semibold text-fog-100">{p.title}</h3>
                <span class="numeric text-xs text-fog-400">{p.year}</span>
              </div>
              <p class="mt-1 text-xs uppercase tracking-wide text-fog-400">{p.context}</p>
              <p class="mt-3 text-sm leading-relaxed text-fog-300">{p.description}</p>

              <div class="mt-4 flex flex-wrap gap-1.5">
                {p.methods.map((m) => (
                  <span class="rounded-md bg-ink-800 px-2 py-0.5 text-[0.7rem] text-fog-300">
                    {m}
                  </span>
                ))}
              </div>

              <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
                {p.reportUrl && (
                  <a
                    href={p.reportUrl}
                    target="_blank"
                    rel="noopener"
                    class="link-underline text-beacon"
                  >
                    {p.reportLabel ?? t("academia.readReport")}
                  </a>
                )}
                <a
                  href={p.repoUrl}
                  target="_blank"
                  rel="noopener"
                  class="link-underline text-fog-300 hover:text-fog-100"
                >
                  {t("academia.sourceOnGithub")}
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Footer nav -->
    <div class="mt-16 border-t border-line/60 pt-8 text-sm">
      <a href={localizePath("/cv", lang)} class="text-beacon hover:text-beacon-600"
        >{t("academia.fullCv")}</a
      >
    </div>
  </div>
</Layout>
