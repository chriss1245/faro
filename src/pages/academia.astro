---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import { thesis, academicProjects } from "../data/academia";

const doiUrl = `https://doi.org/${thesis.doi}`;

// JSON-LD Thesis — gives Google (and Scholar) the DOI, author and institution
// so the record on Zenodo and this page resolve to the same piece of work.
const thesisLd = {
  "@context": "https://schema.org",
  "@type": "Thesis",
  inSupportOf: thesis.degree,
  name: thesis.title,
  headline: thesis.title,
  abstract: thesis.abstract.join(" "),
  datePublished: thesis.datePublished,
  inLanguage: "en",
  identifier: { "@type": "PropertyValue", propertyID: "DOI", value: thesis.doi },
  sameAs: [doiUrl, thesis.recordUrl],
  url: `https://${site.domain}/academia`,
  keywords: thesis.keywords.join(", "),
  license: thesis.license.url,
  author: {
    "@type": "Person",
    name: site.name,
    url: `https://${site.domain}`,
  },
  publisher: { "@type": "Organization", name: "Zenodo" },
  sourceOrganization: { "@type": "CollegeOrUniversity", name: thesis.institution },
  contributor: { "@type": "Person", name: thesis.supervisor },
};

const description = `${thesis.title} — ${thesis.kind}, ${thesis.institution} (${thesis.defended}), DOI ${thesis.doi}. Academic work and case studies by ${site.name}.`;
---

<Layout title="Academia" description={description} image="/og/academia.png">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(thesisLd)} />

  <div class="mx-auto max-w-3xl px-6 pt-20 pb-20">
    <!-- Intro -->
    <header>
      <p class="eyebrow mb-4">// academia</p>
      <h1 class="text-3xl font-semibold leading-tight text-fog-100 sm:text-4xl">
        Research &amp; academic work
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-fog-300">
        My degree is where the statistics under the engineering came from. The
        centrepiece is my bachelor thesis on deep reinforcement learning for
        portfolio management — archived with a DOI, so it is citable and will
        outlive any link I control.
      </p>
    </header>

    <!-- Featured: the thesis -->
    <section class="mt-14" aria-labelledby="thesis-title">
      <h2 class="eyebrow mb-4">// bachelor thesis</h2>

      <article class="rounded-2xl border border-line bg-ink-850/60 p-6 sm:p-8">
        <div class="flex flex-wrap items-center gap-2.5">
          <span
            class="rounded-full border border-aqua/40 px-2.5 py-0.5 text-xs font-medium text-aqua"
          >
            {thesis.kind}
          </span>
          <span class="font-mono text-xs text-fog-400">
            <time datetime={thesis.datePublished}>{thesis.defended}</time>
          </span>
        </div>

        <h3
          id="thesis-title"
          class="mt-4 text-2xl font-semibold leading-snug text-fog-100 sm:text-3xl"
        >
          {thesis.title}
        </h3>

        <dl class="mt-5 space-y-1.5 text-sm">
          <div class="flex flex-wrap gap-x-2">
            <dt class="text-fog-400">Degree</dt>
            <dd class="text-fog-200">{thesis.degree}</dd>
          </div>
          <div class="flex flex-wrap gap-x-2">
            <dt class="text-fog-400">Institution</dt>
            <dd class="text-fog-200">{thesis.institution}</dd>
          </div>
          <div class="flex flex-wrap gap-x-2">
            <dt class="text-fog-400">Supervisor</dt>
            <dd class="text-fog-200">{thesis.supervisor}</dd>
          </div>
          <div class="flex flex-wrap gap-x-2">
            <dt class="text-fog-400">DOI</dt>
            <dd>
              <a
                href={doiUrl}
                class="link-underline font-mono text-beacon"
                target="_blank"
                rel="noopener"
              >
                {thesis.doi}
              </a>
            </dd>
          </div>
        </dl>

        <!-- Actions -->
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a
            href={thesis.pdfUrl}
            target="_blank"
            rel="noopener"
            class="rounded-full bg-beacon px-5 py-2.5 text-sm font-semibold text-on-beacon transition-colors hover:bg-beacon-600"
          >
            Read the thesis (PDF)
          </a>
          <a
            href={thesis.recordUrl}
            target="_blank"
            rel="noopener"
            class="rounded-full border border-line bg-ink-800 px-5 py-2.5 text-sm font-medium text-fog-100 transition-colors hover:border-beacon/50 hover:text-beacon"
          >
            Zenodo record
          </a>
          {
            thesis.codeUrl && (
              <a
                href={thesis.codeUrl}
                target="_blank"
                rel="noopener"
                class="rounded-full border border-line bg-ink-800 px-5 py-2.5 text-sm font-medium text-fog-100 transition-colors hover:border-beacon/50 hover:text-beacon"
              >
                Source code
              </a>
            )
          }
        </div>

        <!-- Abstract -->
        <div class="mt-8 space-y-4 leading-relaxed text-fog-300">
          {thesis.abstract.map((p) => <p>{p}</p>)}
        </div>

        <!-- Contributions -->
        <h4 class="eyebrow mt-9 mb-4">// what's in it</h4>
        <ul class="space-y-3">
          {
            thesis.contributions.map((c) => (
              <li class="flex gap-3 text-sm leading-relaxed text-fog-300">
                <span
                  class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-beacon"
                  aria-hidden="true"
                />
                <span>{c}</span>
              </li>
            ))
          }
        </ul>

        <!-- Evaluation setup -->
        <h4 class="eyebrow mt-9 mb-4">// evaluation</h4>
        <dl class="divide-y divide-line/70 overflow-hidden rounded-xl border border-line">
          {
            thesis.evaluation.map((row) => (
              <div class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:gap-4">
                <dt class="font-mono text-xs uppercase tracking-wide text-fog-400 sm:w-44 sm:shrink-0 sm:pt-0.5">
                  {row.label}
                </dt>
                <dd class="text-sm text-fog-200">{row.value}</dd>
              </div>
            ))
          }
        </dl>

        <!-- Keywords + license -->
        <div class="mt-8 flex flex-wrap gap-1.5">
          {
            thesis.keywords.map((k) => (
              <span class="rounded-md bg-ink-800 px-2 py-0.5 font-mono text-[0.7rem] text-fog-300">
                {k}
              </span>
            ))
          }
        </div>
        <p class="mt-5 border-t border-line/60 pt-5 text-xs text-fog-400">
          Licensed
          <a
            href={thesis.license.url}
            target="_blank"
            rel="noopener license"
            class="link-underline text-fog-300">{thesis.license.label}</a
          >. Cite as: {site.name}. ({new Date(thesis.datePublished).getFullYear()}).
          <em>{thesis.title}</em> [{thesis.kind}]. {thesis.institution}. Zenodo.
          <a href={doiUrl} target="_blank" rel="noopener" class="link-underline text-fog-300"
            >{doiUrl}</a
          >
        </p>
      </article>
    </section>

    <!-- Case studies -->
    <section class="mt-16">
      <h2 class="eyebrow mb-2">// case studies</h2>
      <p class="mb-6 text-sm leading-relaxed text-fog-400">
        Coursework I still stand behind — classical statistics and machine
        learning, implemented from the method up rather than called from a
        library. Each one is public.
      </p>

      <div class="space-y-4">
        {
          academicProjects.map((p) => (
            <article class="card-hover rounded-2xl border border-line bg-ink-850/60 p-6">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="text-lg font-semibold text-fog-100">{p.title}</h3>
                <span class="font-mono text-xs text-fog-400">{p.year}</span>
              </div>
              <p class="mt-1 text-xs uppercase tracking-wide text-fog-400">{p.context}</p>
              <p class="mt-3 text-sm leading-relaxed text-fog-300">{p.description}</p>

              <div class="mt-4 flex flex-wrap gap-1.5">
                {p.methods.map((m) => (
                  <span class="rounded-md bg-ink-800 px-2 py-0.5 font-mono text-[0.7rem] text-fog-300">
                    {m}
                  </span>
                ))}
              </div>

              <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
                {p.reportUrl && (
                  <a
                    href={p.reportUrl}
                    target="_blank"
                    rel="noopener"
                    class="link-underline text-beacon"
                  >
                    {p.reportLabel ?? "Read the report"}
                  </a>
                )}
                <a
                  href={p.repoUrl}
                  target="_blank"
                  rel="noopener"
                  class="link-underline text-fog-300 hover:text-fog-100"
                >
                  Source on GitHub
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Footer nav -->
    <div class="mt-16 border-t border-line/60 pt-8 text-sm">
      <a href="/cv" class="text-beacon hover:text-beacon-600">Read the full CV →</a>
    </div>
  </div>
</Layout>
