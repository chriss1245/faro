---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import { projects } from "../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { project: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

const statusLabel = { live: "Live", building: "Building", soon: "Coming soon" } as const;

// JSON-LD: describe the project as a software application by the author.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: project.name,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description: project.seoDescription,
  url: project.url ?? `https://${site.domain}/${project.slug}`,
  author: {
    "@type": "Person",
    name: site.name,
    url: `https://${site.domain}`,
  },
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<Layout
  title={`${project.name} — ${project.tagline}`}
  description={project.seoDescription}
  image={`/og/${project.slug}.png`}
>
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(jsonLd)}
  />

  <article class="mx-auto max-w-3xl px-6 pt-20 pb-20">
    <!-- Breadcrumb / back -->
    <nav class="mb-8 text-sm text-fog-400" aria-label="Breadcrumb">
      <a href="/#work" class="link-underline hover:text-fog-100">Work</a>
      <span class="px-2 text-fog-500">/</span>
      <span class="text-fog-300 lowercase">{project.name}</span>
    </nav>

    <!-- Header -->
    <header>
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="font-mono text-3xl lowercase text-fog-100 sm:text-4xl">{project.name}</h1>
        <span
          class="rounded-full border border-aqua/40 px-2.5 py-0.5 text-xs font-medium text-aqua"
        >
          {statusLabel[project.status]}
        </span>
      </div>
      <p class="mt-3 text-lg font-medium text-fog-200">{project.tagline}</p>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        {
          project.url && (
            <a
              href={project.url}
              target="_blank"
              rel="noopener"
              class="rounded-full bg-beacon px-5 py-2.5 text-sm font-semibold text-on-beacon transition-colors hover:bg-beacon-600"
            >
              Launch {project.name}
            </a>
          )
        }
        {
          project.blogSlug && (
            <a
              href={`/writing/${project.blogSlug}`}
              class="rounded-full border border-line bg-ink-800 px-5 py-2.5 text-sm font-medium text-fog-100 transition-colors hover:border-beacon/50 hover:text-beacon"
            >
              Read the write-up
            </a>
          )
        }
      </div>
    </header>

    <!-- Overview -->
    <section class="mt-12">
      <h2 class="eyebrow mb-4">// overview</h2>
      <div class="space-y-4 text-fog-300 leading-relaxed">
        {project.overview.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <!-- Highlights -->
    <section class="mt-12">
      <h2 class="eyebrow mb-4">// how it works</h2>
      <ul class="space-y-3">
        {
          project.highlights.map((h) => (
            <li class="flex gap-3 text-fog-300 leading-relaxed">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-beacon" aria-hidden="true" />
              <span>{h}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Stack -->
    <section class="mt-12">
      <h2 class="eyebrow mb-4">// stack</h2>
      <div class="grid gap-5 sm:grid-cols-2">
        {
          project.stack.map((group) => (
            <div class="rounded-xl border border-line bg-ink-850/60 p-5">
              <p class="mb-3 font-mono text-xs uppercase tracking-wide text-fog-400">
                {group.label}
              </p>
              <div class="flex flex-wrap gap-1.5">
                {group.items.map((it) => (
                  <span class="rounded-md bg-ink-800 px-2 py-0.5 font-mono text-[0.7rem] text-fog-300">
                    {it}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Footer nav -->
    <div class="mt-16 border-t border-line/60 pt-8">
      <a href="/#work" class="text-sm text-beacon hover:text-beacon-600">← Back to all work</a>
    </div>
  </article>
</Layout>
