---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { getSite } from "../data/site";
import {
  defaultLang,
  languages,
  localeTags,
  ogLocales,
  ogAlternates,
  routeKey,
  localizePath,
  type Lang,
} from "../i18n/config";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Path (in /public) to the social share image for this page. */
  image?: string;
  /** og:type — "website" for pages, "article" for blog posts. */
  type?: "website" | "article";
  /**
   * Route key ("/", "/cv/") when it cannot be derived from the URL — needed for
   * the English-only blog posts, which have no Spanish counterpart to point at.
   */
  route?: string;
  /** Set for pages that exist in one locale only, so we emit no hreflang set. */
  singleLocale?: boolean;
}

const {
  lang,
  title,
  description,
  image = "/og/default.png",
  type = "website",
  route,
  singleLocale = false,
} = Astro.props;

const site = getSite(lang);
const desc = description ?? site.tagline;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.role}`;

// Absolute URLs (Astro.site is set in astro.config.mjs).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;

// hreflang: every locale's version of this page, plus x-default pointing at the
// unprefixed English one. Google needs the set to be complete and reciprocal.
const key = route ?? routeKey(Astro.url.pathname);
const alternates = singleLocale
  ? []
  : (Object.keys(languages) as Lang[]).map((l) => ({
      hreflang: localeTags[l],
      href: new URL(localizePath(key, l), Astro.site).href,
    }));
---

<!doctype html>
<html lang={localeTags[lang]} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <!-- Apply the stored theme before first paint, otherwise a dark-mode
         visitor gets a white flash on every navigation. Light is the default;
         only an explicit past choice switches it. Kept inline and is:inline
         (no bundling) so it runs ahead of the stylesheet. -->
    <script is:inline>
      // The logo's sprout grows once per visit, not on every page.
      try {
        if (sessionStorage.getItem("mnp-logo")) document.documentElement.classList.add("logo-seen");
        else sessionStorage.setItem("mnp-logo", "1");
      } catch {}
      try {
        if (localStorage.getItem("faro-theme") === "dark") {
          document.documentElement.dataset.theme = "dark";
        }
      } catch (e) {
        /* storage blocked — stay on the default light theme */
      }
    </script>
    <!-- Opt in to the scroll-reveal hidden state (see "Entrance motion" in
         global.css) only once we know JS runs, so without it nothing hides. -->
    <script is:inline>
      document.documentElement.classList.add("js-motion");
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f6fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#08080c" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />

    <!-- The two faces every page paints with. Self-hosted, so preloading them
         costs one round trip and removes the swap flash on the headline. -->
    <link
      rel="preload"
      href="/fonts/source-serif-4-normal-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-normal-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={site.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }
    {
      !singleLocale && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(localizePath(key, defaultLang), Astro.site).href}
        />
      )
    }

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta property="og:locale" content={ogLocales[lang]} />
    {
      !singleLocale &&
        ogAlternates(lang).map((loc) => (
          <meta property="og:locale:alternate" content={loc} />
        ))
    }

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={imageUrl} />

    <slot name="head" />
  </head>
  <body
    class="min-h-screen overflow-x-hidden bg-ink-950 text-fog-100 antialiased selection:bg-beacon/30 selection:text-fog-100"
  >
    <div class="mesh" aria-hidden="true"><i class="a"></i><i class="b"></i><i class="c"></i></div>
    <div class="grain" aria-hidden="true"></div>
    <div class="relative flex min-h-screen flex-col">
      <Nav lang={lang} />
      <main class="flex-1"><slot /></main>
      <Footer lang={lang} />
    </div>
    <!-- Scroll reveal: mark `.reveal` elements (and `.reveal-stagger`
         children) visible the first time they enter the viewport. Elements
         arriving in the same batch are staggered by their order in it, so a
         long list doesn't accumulate delay item after item. Inline so it
         runs right after the DOM it targets, with no bundle to fail to load. -->
    <script is:inline>
      (() => {
        const els = document.querySelectorAll(".reveal, .reveal-stagger > *");
        const show = (el, i = 0) => {
          el.style.setProperty("--i", i);
          el.classList.add("is-visible");
        };
        if (!("IntersectionObserver" in window)) return els.forEach((el) => show(el));
        const io = new IntersectionObserver(
          (entries) =>
            entries
              .filter((e) => e.isIntersecting)
              .forEach((e, i) => {
                show(e.target, i);
                io.unobserve(e.target);
              }),
          { rootMargin: "0px 0px -8% 0px" },
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
